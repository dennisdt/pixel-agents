{
  "$schema": "https://raw.githubusercontent.com/nicegui-app/nicegui-tauri/main/nicegui-tauri/src-tauri/tauri.conf.json",
  "productName": "Pixel Agents",
  "version": "1.0.0",
  "identifier": "com.pixel-agents.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pixel Agents",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "assets/**/*"
    ]
  }
}
